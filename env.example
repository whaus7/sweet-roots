# Google Maps (Water Flow / land survey)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# API
NEXT_PUBLIC_API_DOMAIN=your-api-domain.vercel.app

# Contact form (nodemailer) — server only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@jordhaus.com
SMTP_PASS=your_app_password_here
CONTACT_FROM=contact@jordhaus.com
CONTACT_TO=whaus777@gmail.com

# SMS chat widget (server only)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+15555550100
CHAT_OWNER_PHONE=+13124151093
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# Public site origin, used to validate Twilio's inbound webhook
CHAT_PUBLIC_URL=https://jordhaus.com
